# Copy to /etc/kalshi/env on the server (NOT inside this repo), then:
#   sudo chmod 600 /etc/kalshi/env
export KALSHI_API_KEY_ID="your-api-key-id"
export KALSHI_PRIVATE_KEY_PATH="/etc/kalshi/kalshi_private_key.pem"
# Optional -- defaults to agreer26@gmail.com if unset:
# export KALSHI_ALERT_EMAIL="you@example.com"
